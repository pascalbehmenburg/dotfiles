{
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name} {windows}",
        // Show the real app icons of each workspace's windows next to its number.
        // {windows} must stay in "format", otherwise the taskbar stays empty.
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
            "icon-size": 16,
            "on-click-window": "hyprctl dispatch focuswindow address:{address}"
        }
    },
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂯 {icon} {volume}%",
        "format-muted": "󰝟",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "tooltip-format": "{desc} - {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤮",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "sh ~/scripts/rofi-wifi-menu/rofi-wifi-menu.sh"
    },
    "cpu": {
        "format": "󰻠 {usage}%"
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used"
    },
    "temperature": {
        "interval": 10,
        // k10temp Tctl; hwmon numbers change between boots, the PCI path does not.
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 90,
        "format": "󰔏 {temperatureC}°C",
        "format-critical": "󰸁 {temperatureC}°C"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "tooltip-format": "{timeTo}, {power:.1f} W",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂁", "󰁹"]
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive-items": true,
        "reverse-direction": false
    }
}
